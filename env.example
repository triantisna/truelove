# TRUELOVE — Phase 2B (Prisma + Supabase PostgreSQL)
# NEVER commit your real .env / .env.local to GitHub.

# Runtime on Vercel / serverless:
# Copy Supabase -> Connect -> Transaction pooler (port 6543).
# Example shape:
# postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=""

# Prisma CLI migrations / seed:
# Copy Supabase -> Connect -> Session pooler (port 5432).
# This can also be a direct connection if your network supports it.
# Example shape:
# postgresql://prisma.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=""

# Optional for later Supabase Auth/platform features. Prisma itself does not need these.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Phase 3 — Cloudinary media upload
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="6285872205813"
